# Copia questo file in .streamlit/secrets.toml (ignorato da git) e riempi i
# valori. Senza [auth], l'app resta usabile ma SENZA isolamento dati per
# advisor — vedi ROADMAP.md §7 e README.md "Autenticazione (OIDC)".

# admin_emails = ["tuo@indirizzo.com"]  # sblocca la vista Admin (statistiche, audit log)
# DATABASE_URL = "postgresql+psycopg://user:pw@host/db"  # produzione: Postgres invece di SQLite

[auth]
redirect_uri = "http://localhost:8501/oauth2callback"
cookie_secret = "genera-con: python -c \"import secrets; print(secrets.token_hex(32))\""
client_id = "da console.cloud.google.com → APIs & Services → Credentials"
client_secret = "da console.cloud.google.com → APIs & Services → Credentials"
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"
